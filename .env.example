# Database
DATABASE_URL=postgresql://storyforge:storyforge@db:5432/storyforge

# ComfyUI (running on Windows host, app in Docker)
# COMFYUI_URL=http://host.docker.internal:8188
# COMFYUI_WS_URL=ws://host.docker.internal:8188/ws
# COMFYUI_TIMEOUT=300

# LLM Provider (bất kỳ endpoint OpenAI-compatible: 9Router, OpenAI, Ollama...)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o
# Automatic scene reference images use AI_BASE_URL + AI_API_KEY above.
AI_IMAGE_MODEL=cx/gpt-5.5-image

# Generation providers: which backend handles image/video generation by default.
# Either can be overridden per-request (per Scene/Object) from the UI.
DEFAULT_IMAGE_PROVIDER=agnes
DEFAULT_VIDEO_PROVIDER=agnes
DEFAULT_TEXT_PROVIDER=openai

# Agnes AI (https://agnes-ai.com) — hosted image/video generation API, alternative to ComfyUI
AGNES_AI_API_KEY=
# Nhiều token để round-robin (JSON array hoặc danh sách phân tách bằng dấu phẩy/xuống dòng).
# Token đơn AGNES_AI_API_KEY ở trên được thêm làm fallback nếu chưa có trong pool.
AGNES_AI_API_KEYS=["sk-...", "sk-..."]
AGNES_AI_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_AI_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_AI_VIDEO_MODEL=agnes-video-v2.0
AGNES_AI_TEXT_MODEL=agnes-2.0-flash
# Domain public phục vụ /api/files; bỏ trống khi dev localhost để dùng host ảnh tạm.
AGNES_PUBLIC_MEDIA_BASE_URL=
